<Window x:Class="DragAndDrop_Shihova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DragAndDrop_Shihova"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525" MinHeight="350" MinWidth="525" MouseUp="image_MouseUp">
    <Grid MouseUp="image_MouseUp">
        <Image x:Name="image" MouseUp="image_MouseUp" MouseDown="image_MouseDown" Source="/1.png" Height="50" Width="50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="73,104,0,0"/>
        <Button Content="Обрезка фото" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="12,4" FontSize="14" Click="OpenCropPage_Click"/>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
    </Grid>
</Window>
