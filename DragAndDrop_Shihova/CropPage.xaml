<Page x:Class="DragAndDrop_Shihova.CropPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обрезка фотографии. Шихова" Background="White"
        MouseLeftButtonUp="Page_MouseLeftButtonUp">
    <Page.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#6E6E6E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,2,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8C8C8C">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,1,1"/>
                                <RectangleGeometry Rect="1,1,1,1"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="15,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outer" CornerRadius="16" BorderThickness="4" Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EEEEEE" Offset="0"/>
                                    <GradientStop Color="#9A9A9A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="outer" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <StackPanel Margin="15" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="← Назад" HorizontalAlignment="Left" Padding="12,4" FontSize="14" Margin="0,0,0,10" Click="Back_Click"/>
        <Grid Width="700" HorizontalAlignment="Left" Margin="40,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="Реальный размер"/>
                <TextBlock Style="{StaticResource Value}" x:Name="realSizeText"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Caption}" Text="В масштабе"/>
                <TextBlock Style="{StaticResource Value}" x:Name="scaledSizeText"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="Получится на выходе"/>
                <TextBlock Style="{StaticResource Value}" x:Name="outputSizeText"/>
            </StackPanel>
        </Grid>

        <Border Margin="0,15" BorderBrush="#333333" BorderThickness="8" CornerRadius="8" Padding="30" Background="White">
            <Canvas x:Name="workArea" Width="800" Height="350" ClipToBounds="True"
                    Background="{StaticResource CheckerBrush}">
                <Image x:Name="photo" Stretch="Fill"/>
                <Path x:Name="shade" Fill="#99000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="frame" Stroke="#3A8EE6" StrokeThickness="1" Fill="#01FFFFFF"
                           Cursor="SizeAll" MouseLeftButtonDown="Frame_MouseLeftButtonDown"/>
            </Canvas>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource BigButton}" Content="ОЧИСТИТЬ" Click="Clear_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFA21A" Offset="0"/>
                        <GradientStop Color="#F27A00" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button Style="{StaticResource BigButton}" Content="ОБРЕЗАТЬ" Click="Crop_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#5FCB3A" Offset="0"/>
                        <GradientStop Color="#1E8A0E" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
    </StackPanel>
</Page>
